// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations to content (Tenant/User scope)
  portfolioSettings PortfolioSettings?
  heroSection       HeroSection?
  skillGroups       SkillGroup[]
  skills            Skill[]
  works             Work[]
  clients           Client[]
  services          Service[]
  projects          Project[]
  contacts          Contact[]
  messages          Message[]
  auditLogs         AuditHistory[]
  NavItem           NavItem[]
}

model PortfolioSettings {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  primaryColor   String   @default("#000000")
  secondaryColor String   @default("#FFFFFF")
  toning         String?
  aboutText      String?  @db.Text
  aboutImageUrl  String?
  homeLayout     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HeroSection {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String
  nickname  String?
  title     String
  about     String   @db.Text
  buttons   Json? // e.g. [{ label: "Hire Me", link: "#contact" }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkillGroup {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  icon      String?
  isVisible Boolean  @default(true)
  order     Int      @default(0)
  skills    Skill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  skillGroupId String
  skillGroup   SkillGroup @relation(fields: [skillGroupId], references: [id], onDelete: Cascade)
  name         String
  icon         String?
  level        Int?
  isVisible    Boolean    @default(true)
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Work {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  company     String
  position    String
  startDate   String
  endDate     String?
  description String   @db.Text
  type        String   @default("WORK") // "WORK" | "EDUCATION"
  isVisible   Boolean  @default(true)
  tags        String[] // Array of strings
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Client {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  logoUrl   String?
  url       String?
  review    String?  @db.Text
  rating    Int      @default(5)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  description String   @db.Text
  icon        String?
  highlights  String[] // Array of strings
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  title         String
  description   String   @db.Text
  imageUrl      String?
  gallery       String[] // Array of strings for gallery image URLs
  link          String?
  repo          String?
  tags          String[] // Array of strings for tech stack
  gridSize      String? // e.g. "large", "small" for masonry grid
  featured      Boolean  @default(false)
  featuredOrder Int      @default(0)
  isVisible     Boolean  @default(true)
  colSpan       Int      @default(1)
  rowSpan       Int      @default(1)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Contact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  email     String?
  phone     String?
  location  String?
  socials   Json? // e.g. { github: "url", linkedin: "url" }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String // e.g. "UPDATE_HERO", "LOGIN"
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  email     String
  service   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NavItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String
  sectionId String
  icon      String?
  isVisible Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
